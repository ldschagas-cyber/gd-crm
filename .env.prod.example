APP_NAME=CRM GD Conecta
DEBUG=false
ENVIRONMENT=production

# ============================================================
# DATABASE
# ============================================================
# Usar o hostname do container Docker, não 'localhost'
POSTGRES_USER=crm
POSTGRES_PASSWORD=MUDE-ISSO-PARA-UMA-SENHA-SEGURA
POSTGRES_DB=gd_crm
DATABASE_URL=postgresql+psycopg://crm:MUDE-ISSO-PARA-UMA-SENHA-SEGURA@db:5432/gd_crm

# ============================================================
# REDIS / CELERY
# ============================================================
# Usar o hostname do container Docker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================================
# JWT / SEGURANÇA
# ============================================================
# IMPORTANTE: Gerar uma chave aleatória de 64 caracteres
# $ python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=GERE-UMA-CHAVE-ALEATORIA-DE-64-CARACTERES-COM-O-COMANDO-ACIMA
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Microsoft 365 / Graph (Preferências — E-mail/Calendário)
# ============================================================
MICROSOFT_CLIENT_ID=9951b108-17ac-4f6f-9311-37879970b333
MICROSOFT_TENANT_ID=3312596f-0a4e-46ec-98ca-17962e66f8f3
MICROSOFT_REDIRECT_URI=https://crm.gdconecta.com.br/api/v1/me/integrations/callback
MICROSOFT_CERT_PATH=secrets/crm_graph_private.key
MICROSOFT_CERT_THUMBPRINT=AF0CAD10B9998A975F9691E229C6712FA09EEC05
TOKEN_ENCRYPTION_KEY=6FnGnc93B4kIf5WbGmqNhb1Xl93ILm28CXMP-6d45Dc=
