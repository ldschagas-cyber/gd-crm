APP_NAME=Argos
DEBUG=false
DATABASE_URL=postgresql+psycopg://crm:crm@db:5432/gd_crm
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-de-64-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Inteligência Comercial (Pesquisa de Leads): endpoint interno do Diagnóstico.
# DIAGNOSTICO_INTERNAL_API_KEY precisa ser igual a INTERNAL_API_KEY no .env do Diagnóstico.
DIAGNOSTICO_INTERNAL_URL=http://gd_frete_backend:8000
DIAGNOSTICO_INTERNAL_API_KEY=

# Chamadas (Twilio Voice). TWILIO_API_KEY_SID/_SECRET vêm de Account → API
# keys & tokens (diferente do Account SID/Auth Token). TWILIO_TWIML_APP_SID
# vem de Voice → TwiML Apps. TWILIO_TENANT_ID é o tenant dono do único número
# configurado hoje (ver plano — sem roteamento multi-número ainda).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
TWILIO_TENANT_ID=
TWILIO_VOICE_WEBHOOK_BASE_URL=

# WhatsApp (envio automático de etapas de Sequência, mesma conta Twilio de cima).
# Só preencher depois que a Meta Business Manager verificar a conta e aprovar
# o WhatsApp Sender — até lá, deixe em branco: o envio automático fica
# desligado e as etapas de WhatsApp continuam virando Tarefa manual, como hoje.
TWILIO_WHATSAPP_FROM=
